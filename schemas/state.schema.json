{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Roach Loop v3 State",
  "type": "object",
  "required": [
    "protocol",
    "project",
    "profile",
    "current_checkpoint",
    "checkpoints"
  ],
  "properties": {
    "protocol": {
      "const": "roach-loop/3.0"
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "enum": [
        "fast",
        "standard",
        "strict"
      ]
    },
    "current_checkpoint": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string"
    },
    "checkpoints": {
      "type": "array",
      "items": {
        "$ref": "checkpoint.schema.json"
      }
    }
  }
}
